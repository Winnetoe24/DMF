{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "dmf",
  "rules": {
    "source_file": {
      "type": "REPEAT",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SYMBOL",
            "name": "statement"
          },
          {
            "type": "SYMBOL",
            "name": "identifierStatement"
          }
        ]
      }
    },
    "keyword": {
      "type": "STRING",
      "value": "keyword"
    },
    "componentIdentifier": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "componentIdentifier"
        },
        {
          "type": "SYMBOL",
          "name": "reftype"
        }
      ]
    },
    "parameter": {
      "type": "STRING",
      "value": "parameter"
    },
    "overrideBlock": {
      "type": "STRING",
      "value": "overrideBlock"
    },
    "type": {
      "type": "STRING",
      "value": "type"
    },
    "statement": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "keyword"
        },
        {
          "type": "SYMBOL",
          "name": "type"
        },
        {
          "type": "SYMBOL",
          "name": "componentIdentifier"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "parameter"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "overrideBlock"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "PREC",
          "value": 2,
          "content": {
            "type": "SYMBOL",
            "name": "statementEnd"
          }
        }
      ]
    },
    "identifierStatement": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "identifier"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "overrideBlock"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "statementEnd"
        }
      ]
    },
    "statementEndBuffer": {
      "type": "PATTERN",
      "value": "[[:blank:]]+"
    },
    "statementEnd": {
      "type": "SEQ",
      "members": [
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "statementEndBuffer"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "IMMEDIATE_TOKEN",
              "content": {
                "type": "STRING",
                "value": ";"
              }
            },
            {
              "type": "IMMEDIATE_TOKEN",
              "content": {
                "type": "PATTERN",
                "value": "\\n"
              }
            }
          ]
        }
      ]
    },
    "reftype": {
      "type": "SEQ",
      "members": [
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "dot"
              },
              {
                "type": "SYMBOL",
                "name": "componentName"
              }
            ]
          }
        },
        {
          "type": "SYMBOL",
          "name": "componentName"
        }
      ]
    },
    "componentName": {
      "type": "STRING",
      "value": "cn"
    },
    "semicolon": {
      "type": "STRING",
      "value": ";"
    },
    "newLine": {
      "type": "PATTERN",
      "value": "\\n"
    },
    "package": {
      "type": "STRING",
      "value": "package"
    },
    "struct": {
      "type": "STRING",
      "value": "struct"
    },
    "enum": {
      "type": "STRING",
      "value": "enum"
    },
    "entity": {
      "type": "STRING",
      "value": "entity"
    },
    "interface": {
      "type": "STRING",
      "value": "interface"
    },
    "arg": {
      "type": "STRING",
      "value": "arg"
    },
    "ref": {
      "type": "STRING",
      "value": "ref"
    },
    "func": {
      "type": "STRING",
      "value": "func"
    },
    "expand": {
      "type": "STRING",
      "value": "expand"
    },
    "extends": {
      "type": "STRING",
      "value": "extends"
    },
    "implements": {
      "type": "STRING",
      "value": "implements"
    },
    "identifier": {
      "type": "STRING",
      "value": "identifier"
    },
    "byte": {
      "type": "STRING",
      "value": "byte"
    },
    "int": {
      "type": "STRING",
      "value": "int"
    },
    "long": {
      "type": "STRING",
      "value": "long"
    },
    "double": {
      "type": "STRING",
      "value": "double"
    },
    "datetime": {
      "type": "STRING",
      "value": "datetime"
    },
    "date": {
      "type": "STRING",
      "value": "date"
    },
    "string": {
      "type": "STRING",
      "value": "string"
    },
    "boolean": {
      "type": "STRING",
      "value": "boolean"
    },
    "void": {
      "type": "STRING",
      "value": "void"
    },
    "number": {
      "type": "PATTERN",
      "value": "[0-9]+"
    },
    "dot": {
      "type": "TOKEN",
      "content": {
        "type": "STRING",
        "value": "."
      }
    },
    "byte_content": {
      "type": "PATTERN",
      "value": "[0-9A-F]{4}"
    },
    "version_number": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "number"
        },
        {
          "type": "SYMBOL",
          "name": "dot"
        },
        {
          "type": "SYMBOL",
          "name": "number"
        },
        {
          "type": "SYMBOL",
          "name": "dot"
        },
        {
          "type": "SYMBOL",
          "name": "number"
        }
      ]
    },
    "integerValue": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "number"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "STRING",
                  "value": "_"
                },
                {
                  "type": "SYMBOL",
                  "name": "number"
                }
              ]
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "longValue": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "integerValue"
        },
        {
          "type": "IMMEDIATE_TOKEN",
          "content": {
            "type": "STRING",
            "value": "L"
          }
        }
      ]
    },
    "booleanValue": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "true"
        },
        {
          "type": "STRING",
          "value": "false"
        }
      ]
    },
    "byteValue": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "0x"
        },
        {
          "type": "SYMBOL",
          "name": "byte_content"
        }
      ]
    },
    "doubleValue": {
      "type": "PREC",
      "value": 1,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "SYMBOL",
            "name": "integerValue"
          },
          {
            "type": "SYMBOL",
            "name": "dot"
          },
          {
            "type": "SYMBOL",
            "name": "integerValue"
          }
        ]
      }
    },
    "stringValue": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": "\""
            },
            {
              "type": "ALIAS",
              "content": {
                "type": "REPEAT",
                "content": {
                  "type": "CHOICE",
                  "members": [
                    {
                      "type": "SYMBOL",
                      "name": "string_content_double_quote"
                    },
                    {
                      "type": "SYMBOL",
                      "name": "escape_sequence"
                    }
                  ]
                }
              },
              "named": false,
              "value": "content"
            },
            {
              "type": "STRING",
              "value": "\""
            }
          ]
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": "'"
            },
            {
              "type": "ALIAS",
              "content": {
                "type": "REPEAT",
                "content": {
                  "type": "CHOICE",
                  "members": [
                    {
                      "type": "SYMBOL",
                      "name": "string_content_single_quote"
                    },
                    {
                      "type": "SYMBOL",
                      "name": "escape_sequence"
                    }
                  ]
                }
              },
              "named": false,
              "value": "content"
            },
            {
              "type": "STRING",
              "value": "'"
            }
          ]
        }
      ]
    },
    "string_content_single_quote": {
      "type": "PATTERN",
      "value": "[^'\\\\]+"
    },
    "string_content_double_quote": {
      "type": "PATTERN",
      "value": "[^\"\\\\]+"
    },
    "escape_sequence": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "\\"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "PATTERN",
              "value": "[\\\\'\"bfnrt]"
            },
            {
              "type": "PATTERN",
              "value": "u[0-9a-fA-F]{4}"
            },
            {
              "type": "PATTERN",
              "value": "x[0-9a-fA-F]{2}"
            },
            {
              "type": "PATTERN",
              "value": "[0-7]{1,3}"
            }
          ]
        }
      ]
    },
    "dateTimeValue": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "dateValue"
        },
        {
          "type": "STRING",
          "value": "T"
        },
        {
          "type": "SYMBOL",
          "name": "timeValue"
        }
      ]
    },
    "timeValue": {
      "type": "SEQ",
      "members": [
        {
          "type": "PATTERN",
          "value": "(?:[01][0-9]|2[0-3])"
        },
        {
          "type": "STRING",
          "value": ":"
        },
        {
          "type": "PATTERN",
          "value": "[0-5][0-9]"
        },
        {
          "type": "STRING",
          "value": ":"
        },
        {
          "type": "PATTERN",
          "value": "[0-5][0-9]"
        }
      ]
    },
    "dateValue": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "D"
        },
        {
          "type": "PATTERN",
          "value": "[0-9]{4}"
        },
        {
          "type": "STRING",
          "value": "-"
        },
        {
          "type": "PATTERN",
          "value": "(?:0[1-9]|1[0-2])"
        },
        {
          "type": "STRING",
          "value": "-"
        },
        {
          "type": "PATTERN",
          "value": "(?:0[1-9]|[12][0-9]|3[01])"
        }
      ]
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "\\s"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}